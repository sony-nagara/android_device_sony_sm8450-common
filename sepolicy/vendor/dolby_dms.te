type hal_dms_default, domain;
type hal_dms_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_dms_default)

allow hal_dms_default hwservicemanager:binder { call transfer };
allow hal_dms_default hal_dms_hwservice:hwservice_manager { add find };
allow hal_dms_default hidl_base_hwservice:hwservice_manager add;

get_prop(hal_dms_default, hwservicemanager_prop);
